# RAGChatbot environment configuration
FLASK_ENV=development
FLASK_DEBUG=1
APP_HOST=127.0.0.1
APP_PORT=5000
SECRET_KEY=change-me-in-prod

# Embedding model (sentence-transformers)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# Vector store (FAISS IndexFlatIP — exact cosine, file-backed)
VECTOR_STORE_PATH=writable/vectors

# Chunking
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Retrieval
TOP_K=3
SIMILARITY_METRIC=cosine

# ─────────────────────────────────────────────────────────────
# LLM provider (used for query expansion + chat generation)
# Options: mock | openai | anthropic | gemini | ollama
# Leave as `mock` to satisfy PDF requirement (Vertex AI mocked).
# Set provider + matching API key to use a real LLM.
# ─────────────────────────────────────────────────────────────
LLM_PROVIDER=mock
LLM_MODEL=

# OpenAI (e.g. gpt-4o-mini, gpt-4o)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Claude (e.g. claude-sonnet-4-5, claude-haiku-4-5)
ANTHROPIC_API_KEY=

# Google Gemini (e.g. gemini-1.5-flash, gemini-1.5-pro)
GOOGLE_API_KEY=

# Ollama (local, e.g. llama3.2:3b)
OLLAMA_BASE_URL=http://localhost:11434

# Langfuse (optional - leave blank to disable)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# SQLite
SQLITE_PATH=writable/ragchatbot.db
